{
  "expo": {
    "name": "Mercaboot",
    "slug": "mercaboot",
    "scheme": "mercaboot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mercaboot.app"
    },
    "android": {
      "package": "com.mercaboot.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F7A4D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#1F7A4D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mercaboot necesita tus fotos para que puedas elegir el logo de tu negocio o tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
